# Tony reads every key from environment variables. Set them in Vercel
# (Project -> Settings -> Environment Variables); never commit real values.

# From @BotFather after /newbot.
TELEGRAM_BOT_TOKEN=

# Any long random string you make up. Telegram sends it back with every
# update, and it also unlocks /api/telegram/setup.
TELEGRAM_WEBHOOK_SECRET=

# Your own Telegram chat ID. Tony tells you what it is when you send /start.
# Once set, Tony ignores everyone else.
TELEGRAM_OWNER_ID=

# Supabase project (Project Settings -> API). Server-side only. Not used
# until Phase 2, but created in Phase 1.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Tony's brain: Claude, through the Anthropic API. Create a key at
# console.anthropic.com.
ANTHROPIC_API_KEY=
# Optional.
# ANTHROPIC_MODEL=claude-haiku-5-5
# How hard he thinks before answering: low (default), medium, high.
# ANTHROPIC_EFFORT=low

# Groq: his voice (hearing and speaking), and the brain's fallback when
# Claude cannot answer. Create a key at console.groq.com. The older name
# AI_API_KEY still works.
GROQ_API_KEY=
# Optional. The fallback brain.
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-120b
# Used when the fallback itself has run out of its per-minute allowance ("none" to switch off).
# AI_FALLBACK_MODEL=openai/gpt-oss-20b
# Optional, for the fallback: low, medium or high. Lower uses fewer tokens.
# AI_REASONING_EFFORT=low

# Voice notes: any OpenAI-compatible transcription API. By default it uses
# the Groq key above, so nothing more needs setting.
# STT_MODEL=whisper-large-v3
# STT_BASE_URL=
# STT_API_KEY=

# Spoken replies to voice notes (optional, off by default). On Groq, accept
# the model's terms in the console first; the free allowance is small.
# TTS_MODEL=canopylabs/orpheus-v1-english
# TTS_VOICE=daniel
# "replies" (default): Tony answers voice notes aloud. "all": he also speaks
# the morning brief and the later nudges of a persistent reminder.
# TTS_SPEAK=replies

# Claude reads the text in photos and forwarded posts. This is the Groq
# model used if Claude cannot.
# VISION_MODEL=qwen/qwen3.8-27b
